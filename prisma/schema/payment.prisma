model Payment {
  id                    String @id @default(uuid())

  status                PaymentStatus @default(UNPAID)

  amount                Decimal @db.Decimal(10, 2) // 100.50
  currency              String  @default("BDT")

  paymentGateway        String @default("bkash")
  merchantInvoiceNumber String @unique // appointment id

  bkashPaymentId        String? @unique
  bkashTrxId            String?
  payerReference        String? // user email (recommend) / phone number
  paidAt                String?

  gatewayResponse       Json?

  refundTrxId           String?
  refundReason          String?
  refundedAt            String?
  
  refundAmount          Decimal? @db.Decimal(10, 2)

  appointmentId         String       @unique
  appointment           Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("payments")
}